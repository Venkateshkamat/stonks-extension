{
  "name": "stonks-watch",
  "displayName": "Stonks Watch: Stocks & Crypto",
  "description": "Track NSE, BSE, US stock and crypto holdings: profit/loss in the status bar, a portfolio panel and market heatmaps.",
  "version": "1.0.0",
  "publisher": "venkateshkamat",
  "icon": "media/icon.png",
  "author": "Venkatesh Kamat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Venkateshkamat/stonks-extension.git"
  },
  "homepage": "https://github.com/Venkateshkamat/stonks-extension#readme",
  "bugs": {
    "url": "https://github.com/Venkateshkamat/stonks-extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "stocks",
    "stock market",
    "crypto",
    "cryptocurrency",
    "bitcoin",
    "portfolio",
    "portfolio tracker",
    "nse",
    "bse",
    "nifty",
    "sensex",
    "s&p 500",
    "nasdaq",
    "finance",
    "ticker",
    "stock ticker",
    "status bar",
    "heatmap",
    "watchlist",
    "profit and loss",
    "investing",
    "cursor"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/media/chart.umd.min.js",
    "dist/media/panel.css",
    "dist/media/panel.js",
    "media/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stonks.openPortfolio",
        "title": "Open Portfolio",
        "category": "Stonks"
      },
      {
        "command": "stonks.addHolding",
        "title": "Add Holding",
        "category": "Stonks"
      },
      {
        "command": "stonks.editHolding",
        "title": "Edit Holding",
        "category": "Stonks"
      },
      {
        "command": "stonks.removeHolding",
        "title": "Remove Holding",
        "category": "Stonks"
      },
      {
        "command": "stonks.toggleHideAmounts",
        "title": "Toggle Hide Amounts",
        "category": "Stonks"
      },
      {
        "command": "stonks.setBaseCurrency",
        "title": "Set Base Currency",
        "category": "Stonks"
      },
      {
        "command": "stonks.setRefreshInterval",
        "title": "Set Refresh Interval",
        "category": "Stonks"
      },
      {
        "command": "stonks.pinTicker",
        "title": "Pin Ticker to Status Bar",
        "category": "Stonks"
      },
      {
        "command": "stonks.unpinTicker",
        "title": "Unpin Ticker from Status Bar",
        "category": "Stonks"
      },
      {
        "command": "stonks.refresh",
        "title": "Refresh",
        "category": "Stonks"
      },
      {
        "command": "stonks.setFinnhubApiKey",
        "title": "Set Finnhub API Key",
        "category": "Stonks"
      },
      {
        "command": "stonks.clearFinnhubApiKey",
        "title": "Clear Finnhub API Key",
        "category": "Stonks"
      }
    ],
    "configuration": {
      "title": "Stonks",
      "properties": {
        "stonks.baseCurrency": {
          "type": "string",
          "enum": [
            "INR",
            "USD"
          ],
          "default": "INR",
          "description": "Currency used for portfolio totals (status bar, header totals, chart). Converted with the live USDINR rate."
        },
        "stonks.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "How often quotes are refreshed, in seconds (minimum 15). Closed markets are not refreshed, and a window that is not focused refreshes 5 times less often."
        },
        "stonks.hideAmounts": {
          "type": "boolean",
          "default": false,
          "description": "Hide quantities, prices and amounts; only percentages are shown."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "build:tests": "tsc -p tsconfig.json --outDir out --noEmit false",
    "test": "npm run build:tests && mocha",
    "preview:data": "npm run build:tests && node out/dev/generate-preview-data.js",
    "test:live": "npm run build:tests && node out/test/live/smoke.js",
    "test:integration": "npm run compile && npm run build:tests && node out/test/integration/runTest.js vscode",
    "test:integration:cursor": "npm run compile && npm run build:tests && node out/test/integration/runTest.js cursor",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package",
    "icon": "node scripts/make-icon.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "chart.js": "^4.6.1",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
